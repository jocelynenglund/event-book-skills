{
  "format": "eventbook-plan/1",
  "name": "Tool library",
  "description": "A neighbourhood tool library where members borrow, reserve and return tools. A volunteer keeps the catalogue.",
  "chapters": [
    {
      "name": "Catalogue",
      "steps": [
        {
          "kind": "do",
          "name": "Add Tool",
          "description": "A volunteer adds a tool to the library.",
          "screen": "Add tool form",
          "command": "Add Tool",
          "event": "Tool Added",
          "fields": "toolId, name",
          "scenarios": [
            {
              "name": "A volunteer adds the drill",
              "mustHave": true,
              "given": [],
              "when": {
                "values": {
                  "toolId": "t1",
                  "name": "Drill"
                }
              },
              "then": {
                "event": "Tool Added",
                "values": {
                  "toolId": "t1",
                  "name": "Drill"
                }
              }
            },
            {
              "name": "The same tool cannot be added twice",
              "mustHave": true,
              "given": [
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t1",
                    "name": "Drill"
                  }
                }
              ],
              "when": {
                "values": {
                  "toolId": "t1",
                  "name": "Drill"
                }
              },
              "then": {
                "rejected": "Tool is already in the library"
              }
            }
          ]
        },
        {
          "kind": "see",
          "name": "Tool Shelf",
          "description": "The shelf shows each tool and whether it is in or out.",
          "screen": "Shelf",
          "events": [
            "Tool Added",
            "Tool Borrowed"
          ],
          "readModel": "Tool Shelf",
          "list": true,
          "fields": "toolId, name, status, dueOn",
          "scenarios": [
            {
              "name": "The shelf shows what is in and what is out",
              "mustHave": true,
              "given": [
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t1",
                    "name": "Drill"
                  }
                },
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t2",
                    "name": "Ladder"
                  }
                },
                {
                  "event": "Tool Borrowed",
                  "values": {
                    "loanId": "l1",
                    "memberId": "m1",
                    "toolId": "t1",
                    "borrowedOn": "2026-11-01",
                    "dueOn": "2026-11-08"
                  }
                }
              ],
              "then": {
                "readModel": "Tool Shelf",
                "rows": [
                  {
                    "toolId": "t1",
                    "name": "Drill",
                    "status": "out",
                    "dueOn": "2026-11-08"
                  },
                  {
                    "toolId": "t2",
                    "name": "Ladder",
                    "status": "available",
                    "dueOn": null
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Borrowing",
      "steps": [
        {
          "kind": "do",
          "name": "Borrow Tool",
          "description": "A member borrows a tool for up to 7 days.",
          "screen": "Tool page",
          "command": "Borrow Tool",
          "event": "Tool Borrowed",
          "fields": "loanId, memberId, toolId, borrowedOn, days:number, dueOn",
          "scenarios": [
            {
              "name": "Alex borrows the drill for a week",
              "mustHave": true,
              "given": [
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t1",
                    "name": "Drill"
                  }
                }
              ],
              "when": {
                "values": {
                  "loanId": "l1",
                  "memberId": "m1",
                  "toolId": "t1",
                  "borrowedOn": "2026-11-01",
                  "days": 7
                }
              },
              "then": {
                "event": "Tool Borrowed",
                "values": {
                  "loanId": "l1",
                  "memberId": "m1",
                  "toolId": "t1",
                  "borrowedOn": "2026-11-01",
                  "dueOn": "2026-11-08"
                }
              }
            },
            {
              "name": "A tool that is not in the library is refused",
              "mustHave": true,
              "given": [],
              "when": {
                "values": {
                  "loanId": "l1",
                  "memberId": "m1",
                  "toolId": "t9",
                  "borrowedOn": "2026-11-01",
                  "days": 7
                }
              },
              "then": {
                "rejected": "No such tool"
              }
            },
            {
              "name": "A tool that is already out is refused",
              "mustHave": true,
              "given": [
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t1",
                    "name": "Drill"
                  }
                },
                {
                  "event": "Tool Borrowed",
                  "values": {
                    "loanId": "l1",
                    "memberId": "m1",
                    "toolId": "t1",
                    "borrowedOn": "2026-11-01",
                    "dueOn": "2026-11-08"
                  }
                }
              ],
              "when": {
                "values": {
                  "loanId": "l2",
                  "memberId": "m2",
                  "toolId": "t1",
                  "borrowedOn": "2026-11-02",
                  "days": 7
                }
              },
              "then": {
                "rejected": "Tool is out. You can reserve it."
              }
            },
            {
              "name": "A third tool at once is refused",
              "mustHave": true,
              "given": [
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t1",
                    "name": "Drill"
                  }
                },
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t2",
                    "name": "Ladder"
                  }
                },
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t3",
                    "name": "Lawn mower"
                  }
                },
                {
                  "event": "Tool Borrowed",
                  "values": {
                    "loanId": "l1",
                    "memberId": "m1",
                    "toolId": "t1",
                    "borrowedOn": "2026-11-01",
                    "dueOn": "2026-11-08"
                  }
                },
                {
                  "event": "Tool Borrowed",
                  "values": {
                    "loanId": "l2",
                    "memberId": "m1",
                    "toolId": "t2",
                    "borrowedOn": "2026-11-01",
                    "dueOn": "2026-11-08"
                  }
                }
              ],
              "when": {
                "values": {
                  "loanId": "l3",
                  "memberId": "m1",
                  "toolId": "t3",
                  "borrowedOn": "2026-11-02",
                  "days": 7
                }
              },
              "then": {
                "rejected": "At most 2 tools at a time"
              }
            },
            {
              "name": "A loan longer than 7 days is refused",
              "mustHave": true,
              "given": [
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t1",
                    "name": "Drill"
                  }
                }
              ],
              "when": {
                "values": {
                  "loanId": "l1",
                  "memberId": "m1",
                  "toolId": "t1",
                  "borrowedOn": "2026-11-01",
                  "days": 10
                }
              },
              "then": {
                "rejected": "Loans are 7 days at most"
              }
            },
            {
              "name": "An overdue tool blocks borrowing",
              "mustHave": true,
              "given": [
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t1",
                    "name": "Drill"
                  }
                },
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t2",
                    "name": "Ladder"
                  }
                },
                {
                  "event": "Tool Borrowed",
                  "values": {
                    "loanId": "l1",
                    "memberId": "m1",
                    "toolId": "t1",
                    "borrowedOn": "2026-11-01",
                    "dueOn": "2026-11-08"
                  }
                },
                {
                  "event": "Loan Became Overdue",
                  "values": {
                    "loanId": "l1",
                    "memberId": "m1",
                    "toolId": "t1",
                    "dueOn": "2026-11-08",
                    "daysLate": 1
                  }
                }
              ],
              "when": {
                "values": {
                  "loanId": "l2",
                  "memberId": "m1",
                  "toolId": "t2",
                  "borrowedOn": "2026-11-09",
                  "days": 7
                }
              },
              "then": {
                "rejected": "Bring back your overdue tool first"
              }
            },
            {
              "name": "Borrowing works again once the late tool is back",
              "mustHave": true,
              "given": [
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t1",
                    "name": "Drill"
                  }
                },
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t2",
                    "name": "Ladder"
                  }
                },
                {
                  "event": "Tool Borrowed",
                  "values": {
                    "loanId": "l1",
                    "memberId": "m1",
                    "toolId": "t1",
                    "borrowedOn": "2026-11-01",
                    "dueOn": "2026-11-08"
                  }
                },
                {
                  "event": "Loan Became Overdue",
                  "values": {
                    "loanId": "l1",
                    "memberId": "m1",
                    "toolId": "t1",
                    "dueOn": "2026-11-08",
                    "daysLate": 1
                  }
                },
                {
                  "event": "Tool Returned",
                  "values": {
                    "loanId": "l1",
                    "memberId": "m1",
                    "toolId": "t1",
                    "returnedOn": "2026-11-09"
                  }
                }
              ],
              "when": {
                "values": {
                  "loanId": "l2",
                  "memberId": "m1",
                  "toolId": "t2",
                  "borrowedOn": "2026-11-09",
                  "days": 7
                }
              },
              "then": {
                "event": "Tool Borrowed",
                "values": {
                  "loanId": "l2",
                  "memberId": "m1",
                  "toolId": "t2",
                  "borrowedOn": "2026-11-09",
                  "dueOn": "2026-11-16"
                }
              }
            },
            {
              "name": "A tool held for another member is refused",
              "mustHave": true,
              "given": [
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t1",
                    "name": "Drill"
                  }
                },
                {
                  "event": "Tool Held",
                  "values": {
                    "toolId": "t1",
                    "memberId": "m2",
                    "reservationId": "r1"
                  }
                }
              ],
              "when": {
                "values": {
                  "loanId": "l2",
                  "memberId": "m1",
                  "toolId": "t1",
                  "borrowedOn": "2026-11-09",
                  "days": 7
                }
              },
              "then": {
                "rejected": "Held for another member"
              }
            },
            {
              "name": "The member the tool is held for can borrow it",
              "mustHave": true,
              "given": [
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t1",
                    "name": "Drill"
                  }
                },
                {
                  "event": "Tool Held",
                  "values": {
                    "toolId": "t1",
                    "memberId": "m2",
                    "reservationId": "r1"
                  }
                }
              ],
              "when": {
                "values": {
                  "loanId": "l2",
                  "memberId": "m2",
                  "toolId": "t1",
                  "borrowedOn": "2026-11-09",
                  "days": 7
                }
              },
              "then": {
                "event": "Tool Borrowed",
                "values": {
                  "loanId": "l2",
                  "memberId": "m2",
                  "toolId": "t1",
                  "borrowedOn": "2026-11-09",
                  "dueOn": "2026-11-16"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reserving",
      "steps": [
        {
          "kind": "do",
          "name": "Reserve Tool",
          "description": "A member joins the queue for a tool that is out. Reserving the same tool twice by the same member changes nothing (no event is recorded).",
          "screen": "Tool page",
          "command": "Reserve Tool",
          "event": "Tool Reserved",
          "fields": "reservationId, memberId, toolId",
          "scenarios": [
            {
              "name": "Sam reserves the drill while Alex has it",
              "mustHave": true,
              "given": [
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t1",
                    "name": "Drill"
                  }
                },
                {
                  "event": "Tool Borrowed",
                  "values": {
                    "loanId": "l1",
                    "memberId": "m1",
                    "toolId": "t1",
                    "borrowedOn": "2026-11-01",
                    "dueOn": "2026-11-08"
                  }
                }
              ],
              "when": {
                "values": {
                  "reservationId": "r1",
                  "memberId": "m2",
                  "toolId": "t1"
                }
              },
              "then": {
                "event": "Tool Reserved",
                "values": {
                  "reservationId": "r1",
                  "memberId": "m2",
                  "toolId": "t1"
                }
              }
            },
            {
              "name": "A tool on the shelf cannot be reserved",
              "mustHave": true,
              "given": [
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t1",
                    "name": "Drill"
                  }
                }
              ],
              "when": {
                "values": {
                  "reservationId": "r1",
                  "memberId": "m2",
                  "toolId": "t1"
                }
              },
              "then": {
                "rejected": "Tool is available. Borrow it instead."
              }
            },
            {
              "name": "A tool that is not in the library is refused",
              "mustHave": true,
              "given": [],
              "when": {
                "values": {
                  "reservationId": "r1",
                  "memberId": "m2",
                  "toolId": "t9"
                }
              },
              "then": {
                "rejected": "No such tool"
              }
            },
            {
              "name": "The member who has the tool cannot reserve it",
              "mustHave": true,
              "given": [
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t1",
                    "name": "Drill"
                  }
                },
                {
                  "event": "Tool Borrowed",
                  "values": {
                    "loanId": "l1",
                    "memberId": "m1",
                    "toolId": "t1",
                    "borrowedOn": "2026-11-01",
                    "dueOn": "2026-11-08"
                  }
                }
              ],
              "when": {
                "values": {
                  "reservationId": "r1",
                  "memberId": "m1",
                  "toolId": "t1"
                }
              },
              "then": {
                "rejected": "You already have this tool"
              }
            }
          ]
        },
        {
          "kind": "auto",
          "name": "Hold Tool For Next Member",
          "description": "When a tool comes back, it is held for the first member in its queue. If nobody reserved it, nothing is recorded and it goes back on the shelf.",
          "command": "Hold Tool For Next Member",
          "when": "Tool Returned",
          "using": "Reservation Queue",
          "todo": true,
          "processor": "Tool holder",
          "result": "Tool Held",
          "fields": "toolId, memberId, reservationId",
          "scenarios": [
            {
              "name": "A returned tool is held for the member who reserved it",
              "mustHave": true,
              "given": [
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t1",
                    "name": "Drill"
                  }
                },
                {
                  "event": "Tool Borrowed",
                  "values": {
                    "loanId": "l1",
                    "memberId": "m1",
                    "toolId": "t1",
                    "borrowedOn": "2026-11-01",
                    "dueOn": "2026-11-08"
                  }
                },
                {
                  "event": "Tool Reserved",
                  "values": {
                    "reservationId": "r1",
                    "memberId": "m2",
                    "toolId": "t1"
                  }
                },
                {
                  "event": "Tool Returned",
                  "values": {
                    "loanId": "l1",
                    "memberId": "m1",
                    "toolId": "t1",
                    "returnedOn": "2026-11-07"
                  }
                }
              ],
              "when": {
                "values": {
                  "toolId": "t1"
                }
              },
              "then": {
                "event": "Tool Held",
                "values": {
                  "toolId": "t1",
                  "memberId": "m2",
                  "reservationId": "r1"
                }
              }
            },
            {
              "name": "With two reservations, the first one in line gets it",
              "mustHave": true,
              "given": [
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t1",
                    "name": "Drill"
                  }
                },
                {
                  "event": "Tool Borrowed",
                  "values": {
                    "loanId": "l1",
                    "memberId": "m1",
                    "toolId": "t1",
                    "borrowedOn": "2026-11-01",
                    "dueOn": "2026-11-08"
                  }
                },
                {
                  "event": "Tool Reserved",
                  "values": {
                    "reservationId": "r1",
                    "memberId": "m2",
                    "toolId": "t1"
                  }
                },
                {
                  "event": "Tool Reserved",
                  "values": {
                    "reservationId": "r2",
                    "memberId": "m3",
                    "toolId": "t1"
                  }
                },
                {
                  "event": "Tool Returned",
                  "values": {
                    "loanId": "l1",
                    "memberId": "m1",
                    "toolId": "t1",
                    "returnedOn": "2026-11-07"
                  }
                }
              ],
              "when": {
                "values": {
                  "toolId": "t1"
                }
              },
              "then": {
                "event": "Tool Held",
                "values": {
                  "toolId": "t1",
                  "memberId": "m2",
                  "reservationId": "r1"
                }
              }
            }
          ]
        },
        {
          "kind": "see",
          "name": "Reservation Queue",
          "description": "Who is waiting for a tool, in order.",
          "screen": "Tool page",
          "events": [
            "Tool Reserved",
            "Tool Held"
          ],
          "readModel": "Reservation Queue",
          "list": true,
          "fields": "position:number, reservationId, memberId, toolId",
          "scenarios": [
            {
              "name": "The queue shows who is waiting, in order",
              "mustHave": true,
              "given": [
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t1",
                    "name": "Drill"
                  }
                },
                {
                  "event": "Tool Borrowed",
                  "values": {
                    "loanId": "l1",
                    "memberId": "m1",
                    "toolId": "t1",
                    "borrowedOn": "2026-11-01",
                    "dueOn": "2026-11-08"
                  }
                },
                {
                  "event": "Tool Reserved",
                  "values": {
                    "reservationId": "r1",
                    "memberId": "m2",
                    "toolId": "t1"
                  }
                },
                {
                  "event": "Tool Reserved",
                  "values": {
                    "reservationId": "r2",
                    "memberId": "m3",
                    "toolId": "t1"
                  }
                }
              ],
              "then": {
                "readModel": "Reservation Queue",
                "rows": [
                  {
                    "position": 1,
                    "reservationId": "r1",
                    "memberId": "m2",
                    "toolId": "t1"
                  },
                  {
                    "position": 2,
                    "reservationId": "r2",
                    "memberId": "m3",
                    "toolId": "t1"
                  }
                ]
              }
            },
            {
              "name": "A reservation leaves the queue once the tool is held for it",
              "mustHave": true,
              "given": [
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t1",
                    "name": "Drill"
                  }
                },
                {
                  "event": "Tool Reserved",
                  "values": {
                    "reservationId": "r1",
                    "memberId": "m2",
                    "toolId": "t1"
                  }
                },
                {
                  "event": "Tool Held",
                  "values": {
                    "toolId": "t1",
                    "memberId": "m2",
                    "reservationId": "r1"
                  }
                }
              ],
              "then": {
                "readModel": "Reservation Queue",
                "rows": []
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Returning",
      "steps": [
        {
          "kind": "do",
          "name": "Return Tool",
          "description": "A member brings a tool back. Returning twice changes nothing (no event is recorded).",
          "screen": "My loans",
          "command": "Return Tool",
          "event": "Tool Returned",
          "fields": "loanId, returnedOn, memberId, toolId",
          "scenarios": [
            {
              "name": "Alex brings the drill back on time",
              "mustHave": true,
              "given": [
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t1",
                    "name": "Drill"
                  }
                },
                {
                  "event": "Tool Borrowed",
                  "values": {
                    "loanId": "l1",
                    "memberId": "m1",
                    "toolId": "t1",
                    "borrowedOn": "2026-11-01",
                    "dueOn": "2026-11-08"
                  }
                }
              ],
              "when": {
                "values": {
                  "loanId": "l1",
                  "returnedOn": "2026-11-07"
                }
              },
              "then": {
                "event": "Tool Returned",
                "values": {
                  "loanId": "l1",
                  "memberId": "m1",
                  "toolId": "t1",
                  "returnedOn": "2026-11-07"
                }
              }
            },
            {
              "name": "Returning a loan that does not exist is refused",
              "mustHave": true,
              "given": [],
              "when": {
                "values": {
                  "loanId": "l9",
                  "returnedOn": "2026-11-07"
                }
              },
              "then": {
                "rejected": "No such loan"
              }
            }
          ]
        },
        {
          "kind": "auto",
          "name": "Mark Loan Overdue",
          "description": "A daily check marks loans past their due date as overdue, passing in today's date. Loans not yet due or already returned are left alone (no event is recorded).",
          "command": "Mark Loan Overdue",
          "processor": "Overdue checker",
          "result": "Loan Became Overdue",
          "fields": "loanId, today, memberId, toolId, dueOn, daysLate:number",
          "scenarios": [
            {
              "name": "A loan past its due date is marked overdue (daily check)",
              "mustHave": true,
              "given": [
                {
                  "event": "Tool Added",
                  "values": {
                    "toolId": "t1",
                    "name": "Drill"
                  }
                },
                {
                  "event": "Tool Borrowed",
                  "values": {
                    "loanId": "l1",
                    "memberId": "m1",
                    "toolId": "t1",
                    "borrowedOn": "2026-11-01",
                    "dueOn": "2026-11-08"
                  }
                }
              ],
              "when": {
                "values": {
                  "loanId": "l1",
                  "today": "2026-11-09"
                }
              },
              "then": {
                "event": "Loan Became Overdue",
                "values": {
                  "loanId": "l1",
                  "memberId": "m1",
                  "toolId": "t1",
